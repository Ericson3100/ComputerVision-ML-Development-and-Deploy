FROM golang:1.21-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    git \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m pip install --no-cache-dir --only-binary=:all: tensorflow-cpu==2.15.0 \
    && python3 -c "import tensorflow as tf; print(tf.__version__)"

WORKDIR /app

COPY go.mod go.sum* ./

RUN go mod download

EXPOSE 8080

CMD ["go", "run", "."]
